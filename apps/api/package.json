{
  "name": "api",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts --exclude '**/*.test.ts'",
    "build": "tsc -p tsconfig.production.json && tsc-alias",
