    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.1.0",
    "@huggingface/inference": "^4.13.15",
    "@repo/logger": "*",
    "@repo/shared": "*",
    "@scalar/express-api-reference": "^0.8.20",
    "body-parser": "^2.2.0",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "mongoose": "^8.19.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@repo/eslint-config": "*",
    "@repo/prettier-config": "*",
    "@repo/types": "*",
    "@repo/typescript-config": "*",
    "@repo/vitest-config": "*",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.6.2",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.2.1",
