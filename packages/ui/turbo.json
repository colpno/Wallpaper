{
  "extends": ["//"],
  "tasks": {
    "dev:styles": {
      "cache": false,
      "persistent": true
    },
    "dev:components": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["build:styles", "build:components"]
    },
    "build:styles": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"],
      "env": ["VITE_API_URL"]
    },
    "build:components": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"],
      "env": ["VITE_API_URL"]
    }
  }
}
